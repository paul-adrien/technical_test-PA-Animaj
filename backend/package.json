{
	"name": "millennium-falcon-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Backend for the Millennium Falcon route computation API",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.5",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
